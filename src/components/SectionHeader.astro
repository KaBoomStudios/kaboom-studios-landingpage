---
import Reveal from './Reveal.astro';

interface Props {
  /** Kleine Zeile ueber der Ueberschrift. */
  eyebrow: string;
  title: string;
  /** id der H2, auf die die Sektion per aria-labelledby verweist. */
  id: string;
}

const { eyebrow, title, id } = Astro.props;
---

{/* Kopf einer Sektion in derselben Form wie auf der Startseite. Ein
    optionaler Einleitungstext kommt als Inhalt dazu. */}
<div class="mb-14 max-w-[640px]">
  <p class="mb-3.5 text-[13px] font-bold tracking-[0.08em] uppercase text-accent">
    {eyebrow}
  </p>
  <Reveal>
    <h2
      id={id}
      class="mb-4 text-[clamp(1.75rem,3.5vw,2.625rem)] font-extrabold tracking-[-0.02em] text-white"
    >
      {title}
    </h2>
    <div class="flex flex-col gap-4 text-base leading-relaxed text-body">
      <slot />
    </div>
  </Reveal>
</div>
