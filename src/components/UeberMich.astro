---
import Reveal from './Reveal.astro';
import CountUp from './CountUp.astro';
import { imprint, pages, site } from '../data/site';
---

{/* Kurzfassung fuer die Startseite. Die ganze Geschichte steht auf der Seite
    "Ueber mich". Das Foto steht schon im Hero und wird hier nicht
    wiederholt. */}
<section
  id="ueber-mich"
  aria-labelledby="ueber-mich-titel"
  class="mx-auto flex max-w-[1280px] flex-col gap-12 px-5 py-20 sm:px-8 lg:flex-row lg:items-start lg:gap-16 lg:px-12 lg:py-25"
>
  <div class="lg:flex-1">
    <p class="mb-3.5 text-[13px] font-bold tracking-[0.08em] uppercase text-accent">
      Über mich
    </p>
    <Reveal>
      <h2
        id="ueber-mich-titel"
        class="mb-6 max-w-[520px] text-[clamp(1.75rem,3.5vw,2.625rem)] font-extrabold tracking-[-0.02em] text-white"
      >
        Ich komme selbst aus dem Handwerk
      </h2>
      <div class="flex max-w-[600px] flex-col gap-4 text-base leading-[1.75] text-body">
        <p>
          22 Jahre habe ich im Handwerk gearbeitet. Ich kenne den Alltag im
          Betrieb: tagsüber auf der Baustelle, abends am Schreibtisch für
          Angebote und Rechnungen. Wer anruft, erwischt einen selten im
          richtigen Moment. Und gute Auszubildende sind schwer zu finden.
        </p>
        <p>
          Technik begleitet mich mein ganzes Leben. Heute baue ich Websites,
          die Betrieben im Alltag Arbeit abnehmen.
        </p>
      </div>
      <a
        href={pages.ueberMich.href}
        class="mt-8 inline-flex items-center rounded-full border border-surface-2 px-6 py-3 text-[15px] font-semibold text-white transition-colors hover:border-accent"
      >
        Mehr über mich
      </a>
    </Reveal>
  </div>

  <Reveal delay={150} class="w-full lg:w-80 lg:shrink-0">
    <ul class="flex flex-col gap-4">
      <li class="rounded-2xl border border-surface-2 bg-surface p-6">
        <p class="text-[28px] font-extrabold text-accent">
          <CountUp to={22} />
        </p>
        <p class="mt-1 text-sm text-body">Jahre im Handwerk</p>
      </li>
      {/* Die ganze Kachel ist der Link zur Seite fuer die Region. */}
      <li>
        <a
          href={pages.rheinSieg.href}
          class="group block rounded-2xl border border-surface-2 bg-surface p-6 transition-colors hover:border-accent"
        >
          <p class="text-[28px] font-extrabold text-accent">{imprint.city}</p>
          <p class="mt-1 text-sm text-body">
            Sitz im {site.region}, einmal pro Projekt komme ich zu Ihnen in den Betrieb
          </p>
          <p class="mt-3 text-sm font-semibold text-white group-hover:text-accent-soft">
            {pages.rheinSieg.title}
          </p>
        </a>
      </li>
    </ul>
  </Reveal>
</section>
