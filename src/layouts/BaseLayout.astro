---
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import type { Node } from '../lib/structured-data';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Strukturierte Daten dieser Seite, siehe src/lib/structured-data.ts. */
  structuredData?: Node[];
}

const { title, description, noindex, structuredData = [] } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Die Schrift entscheidet ueber den LCP: eine variable Datei fuer alle
        Schnitte, deshalb genuegt ein Preload. */}
    <link
      rel="preload"
      href="/fonts/inter-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <Seo title={title} description={description} noindex={noindex} />
    <JsonLd nodes={structuredData} />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-accent focus:px-5 focus:py-2.5 focus:font-bold focus:text-on-accent"
    >
      Zum Inhalt springen
    </a>
    <slot />
  </body>
</html>
