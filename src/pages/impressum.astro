---
import LegalPage from '../components/LegalPage.astro';
import { contact, imprint, site } from '../data/site';

// Nur die Angaben, die der Betreiber geliefert hat. Kein zusaetzlicher
// Rechtstext: Haftungs- und Urheberrechtsklauseln sind nicht vorgeschrieben
// und werden hier nicht erfunden.
const sectionClass = 'text-[13px] font-bold tracking-[0.08em] uppercase text-accent';

// Erscheinen erst, wenn eine Nummer zugeteilt und in site.ts eingetragen ist.
const ids = [
  imprint.vatId && `Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG: ${imprint.vatId}`,
  imprint.businessId && `Wirtschafts-Identifikationsnummer gemäß § 139c AO: ${imprint.businessId}`,
].filter(Boolean);
---

<LegalPage
  title="Impressum"
  metaTitle="Impressum | KaBoom Studios"
  description={`Anbieterkennzeichnung nach § 5 DDG für ${site.name}, ${imprint.name}.`}
  placeholder={false}
>
  <div class="flex flex-col gap-10">
    <section aria-labelledby="anbieter">
      <h2 id="anbieter" class={sectionClass}>Angaben gemäß § 5 DDG</h2>
      <address class="mt-3 text-base leading-[1.75] text-body not-italic">
        {imprint.name}<br />
        {imprint.street}<br />
        {imprint.postalCode}&nbsp;{imprint.city}
      </address>
    </section>

    <section aria-labelledby="kontakt">
      <h2 id="kontakt" class={sectionClass}>Kontakt</h2>
      <p class="mt-3 text-base leading-[1.75] text-body">
        Telefon: <a
          href={imprint.phoneHref}
          class="font-medium text-accent hover:text-accent-soft"
          >{imprint.phone}</a
        ><br />
        E-Mail: <a
          href={contact.emailHref}
          class="font-medium text-accent wrap-anywhere hover:text-accent-soft"
          >{contact.email}</a
        >
      </p>
    </section>

    {
      ids.length > 0 && (
        <section aria-labelledby="identifikation">
          <h2 id="identifikation" class={sectionClass}>
            Identifikationsnummern
          </h2>
          <p class="mt-3 text-base leading-[1.75] text-body">
            {ids.map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))}
          </p>
        </section>
      )
    }
  </div>
</LegalPage>
